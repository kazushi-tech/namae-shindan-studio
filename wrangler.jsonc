{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namae-studio",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  // Vercel の cleanUrls: true / trailingSlash: false と同じく、/about.html と /about/ は /about へ寄せる
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}

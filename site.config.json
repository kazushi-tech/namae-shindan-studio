{
  "$schema": "./scripts/schemas/site.config.schema.json",
  "siteId": "namae-studio",
  "version": "1.0.0",
  "brand": {
    "name": "赤ちゃん名前診断",
    "shortName": "名前診断",
    "tagline": "大切なお子さまに最高の名前を",
    "description": "無料の姓名判断サービス。赤ちゃんの名前の画数から五格を診断します。",
    "emoji": "🌸"
  },
  "domain": {
    "primary": "namae-studio.com",
    "url": "https://namae-studio.com",
    "column": "https://column.namae-studio.com/"
  },
  "locale": {
    "lang": "ja",
    "og": "ja_JP",
    "country": "JP",
    "currency": "JPY"
  },
  "colors": {
    "primary": "#E8725C",
    "primaryDark": "#C4704B",
    "primaryLight": "#F09A88",
    "secondary": "#6EC4A8",
    "accent": "#F0B84D",
    "background": "#FFF8F0",
    "dark": "#3D3029",
    "muted": "#8B7B6F",
    "themeColor": "#E8725C"
  },
  "fonts": {
    "heading": "'Zen Maru Gothic', serif",
    "body": "'Noto Sans JP', sans-serif",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Zen+Maru+Gothic:wght@400;500;700;900&display=swap"
  },
  "analytics": {
    "ga4MeasurementId": null,
    "searchConsoleVerifyId": null,
    "adsense": {
      "client": null,
      "enabled": false
    }
  },
  "affiliates": {
    "amazon": { "tag": null, "enabled": false },
    "rakuten": { "id": null, "enabled": false },
    "moshimo": { "uid": null, "enabled": false },
    "a8": { "ajaTag": null, "enabled": false },
    "afb": { "siteId": null, "enabled": false }
  },
  "nav": [
    { "label": "ホーム", "href": "/", "match": ["/", "/index.html"] },
    { "label": "姓名判断", "href": "/shindan", "match": ["/shindan", "/shindan.html"] },
    { "label": "お気に入り", "href": "/favorites", "match": ["/favorites", "/favorites.html"] },
    { "label": "五格について", "href": "/about", "match": ["/about", "/about.html"] },
    { "label": "コラム", "href": "https://column.namae-studio.com/", "external": true }
  ],
  "navFuture": [
    { "label": "名前候補", "href": "/suggestion", "match": ["/suggestion"], "note": "Phase 3で公開予定" },
    { "label": "ランキング", "href": "/ranking/", "match": ["/ranking"], "note": "Phase 3で公開予定" },
    { "label": "漢字辞典", "href": "/kanji/", "match": ["/kanji"], "note": "Phase 3で公開予定" },
    { "label": "ガイド", "href": "/guide/", "match": ["/guide"], "note": "Phase 3で公開予定" }
  ],
  "footer": {
    "copyright": "© 2026 赤ちゃん名前診断",
    "links": [
      { "label": "ホーム", "href": "/" },
      { "label": "姓名判断", "href": "/shindan" },
      { "label": "お気に入り", "href": "/favorites" },
      { "label": "五格について", "href": "/about" },
      { "label": "コラム", "href": "https://column.namae-studio.com/", "external": true },
      { "label": "プライバシーポリシー", "href": "/privacy-policy" }
    ]
  },
  "tool": {
    "type": "seimei-handan",
    "schema": "./tool/schema.json",
    "engine": "./js/seimei-handan.js"
  },
  "ads": {
    "slots": {
      "home_after_features": { "enabled": false, "format": "horizontal" },
      "home_before_disclaimer": { "enabled": false, "format": "infeed" },
      "shindan_header": { "enabled": false, "format": "horizontal" },
      "shindan_result_rect": { "enabled": false, "format": "rect" },
      "shindan_result_multiplex": { "enabled": false, "format": "multiplex" },
      "about_example": { "enabled": false, "format": "infeed" },
      "about_rating": { "enabled": false, "format": "rect" },
      "mobile_anchor": { "enabled": false, "format": "anchor" },
      "guide_h2": { "enabled": false, "format": "infeed" }
    }
  },
  "build": {
    "outputDir": "dist",
    "templatesDir": "templates",
    "contentDir": "content",
    "kanjiPages": {
      "initialCount": 20,
      "targetCount": 300
    }
  }
}

{{!-- partials/head-meta.hbs — 共通の <head> 内メタ・OG・リンク --}}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{meta.title}}</title>
  <meta name="description" content="{{meta.description}}">

  <!-- OG Tags -->
  <meta property="og:title" content="{{meta.og.title}}">
  <meta property="og:description" content="{{meta.og.description}}">
  <meta property="og:type" content="{{meta.og.type}}">
  <meta property="og:locale" content="{{site.locale.og}}">
  <meta property="og:image" content="{{site.domain.url}}{{meta.og.image}}">
  <meta property="og:url" content="{{site.domain.url}}{{path}}">
  <link rel="canonical" href="{{site.domain.url}}{{path}}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{meta.og.title}}">
  <meta name="twitter:description" content="{{meta.og.description}}">
  <meta name="twitter:image" content="{{site.domain.url}}{{meta.og.image}}">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="{{site.fonts.googleFontsUrl}}" rel="stylesheet">

  <!-- CSS -->
  <link rel="stylesheet" href="/css/reset.css?v={{buildVersion}}">
  <link rel="stylesheet" href="/css/variables.css?v={{buildVersion}}">
  <link rel="stylesheet" href="/css/base.css?v={{buildVersion}}">
  <link rel="stylesheet" href="/css/components.css?v={{buildVersion}}">
  <link rel="stylesheet" href="/css/layout.css?v={{buildVersion}}">
  <link rel="stylesheet" href="/css/animations.css?v={{buildVersion}}">
  {{#if pageCss}}<link rel="stylesheet" href="/css/pages/{{pageCss}}.css?v={{buildVersion}}">{{/if}}

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/assets/images/favicon.png">
  <link rel="apple-touch-icon" href="/assets/images/logo-icon.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="{{site.colors.themeColor}}">

  {{#if site.analytics.ga4MeasurementId}}
  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{site.analytics.ga4MeasurementId}}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{site.analytics.ga4MeasurementId}}', { anonymize_ip: true });
  </script>
  {{/if}}

  {{#if site.analytics.adsense.enabled}}
  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{site.analytics.adsense.client}}" crossorigin="anonymous"></script>
  {{/if}}

  {{!-- ページ個別の JSON-LD は {{> jsonLd}} で注入 --}}
  {{> jsonLd}}

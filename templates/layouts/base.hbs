{{!-- Service Worker 解除 --}}
<script>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.getRegistrations().then(function(regs) {
      regs.forEach(function(r) { r.unregister(); });
    });
    if (caches) {
      caches.keys().then(function(names) { names.forEach(function(n) { caches.delete(n); }); });
    }
  }
</script>

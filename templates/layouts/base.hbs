<!DOCTYPE html>
<html lang="{{site.locale.lang}}">
<head>
{{> headMeta}}
</head>
<body data-page="{{page}}"{{#if bodyClass}} class="{{bodyClass}}"{{/if}}>

{{> gtmNoscript}}
{{> skipLink}}
{{> nav}}

<main{{#unless (eq mainClass "")}} class="{{#if mainClass}}{{mainClass}}{{else}}section{{/if}}"{{/unless}} id="main-content" tabindex="-1">
{{{body}}}
</main>

{{> footer}}

{{#unless skipExtraScripts}}{{> coreScripts}}{{/unless}}

{{#if extraInlineScript}}
<script>{{{extraInlineScript}}}</script>
{{/if}}

{{> serviceWorkerUnregister}}
{{> liveRegion}}
</body>
</html>
